<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/update.css" />
    <title>Edit <%= card.name %></title>
  </head>
  <%- include("partials/header") %>
  <%- include("partials/nav") %>
  <body>
    <main>
      <div class="topcardCon">
        <h1>Edit: <%= card.name %></h1>
        <h2><%= card.manaValue %></h2>
      </div>

      <div class="formCon">
        <form action="/cards/<%= card.id %>/update" method="post">

          <div class="formGroup">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= card.name %>" required />
          </div>

          <div class="formGroup">
            <label for="manaValue">Mana Value</label>
            <input type="number" id="manaValue" name="manaValue" value="<%= card.manaValue %>" min="0" required />
          </div>

          <div class="formGroup">
            <label for="rarity">Rarity</label>
            <select id="rarity" name="rarity">
              <option value="common"    <%= card.rarity.toLowerCase() === "common"    ? "selected" : "" %>>Common</option>
              <option value="uncommon"  <%= card.rarity.toLowerCase() === "uncommon"  ? "selected" : "" %>>Uncommon</option>
              <option value="rare"      <%= card.rarity.toLowerCase() === "rare"      ? "selected" : "" %>>Rare</option>
              <option value="mythic"    <%= card.rarity.toLowerCase() === "mythic"    ? "selected" : "" %>>Mythic</option>
              <option value="legendary" <%= card.rarity.toLowerCase() === "legendary" ? "selected" : "" %>>Legendary</option>
            </select>
          </div>

          <div class="formGroup">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4"><%= card.description %></textarea>
          </div>

          <div class="formGroup">
            <label for="releaseDate">Release Date</label>
            <input type="text" id="releaseDate" name="releaseDate" value="<%= card.releaseDate %>" />
          </div>

          <div class="buttonCon">
            <a href="/cards/<%= card.id %>" class="cancelBtn">Cancel</a>
            <button type="submit" class="saveBtn">Save Changes</button>
          </div>

        </form>
      </div>
    </main>
  </body>
</html>
