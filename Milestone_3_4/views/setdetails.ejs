<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/setdetail.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <title><%= foundSet.name %></title>
  </head>
  <%- include("partials/header") %>
  <%- include("partials/nav") %>
  <body>
    <main>
      <div class="topsetCon">
        <h1><%= foundSet.name %></h1>
        <h2><%= foundSet.code %></h2>
      </div>

      <div class="imageCon">
        <img src="<%= foundSet.logoUrl %>" alt="<%= foundSet.name %> logo" />
      </div>

      <div id="SetDescription">
        <p>
          Release year: <strong><%= foundSet.releaseYear %></strong>
        </p>
        <p>
          Standard legal:
          <span class="<%= foundSet.isStandardLegal ? 'legal' : 'notLegal' %>">
            <%= foundSet.isStandardLegal ? "Yes" : "No" %>
          </span>
        </p>
      </div>

      <p class="setCardsTitle">Cards in this set</p>
      <div class="cardGrid">
        <% const setCards = deckData.filter(card => card.cardSet.id === foundSet.id); %>
        <% if (setCards.length === 0) { %>
          <p>No cards found for this set.</p>
        <% } else { %>
          <% setCards.forEach(card => { %>
            <div class="cardItem">
              <a href="/cards/<%= card.id %>">
                <img src="<%= card.imagePath %>" alt="<%= card.name %>" />
              </a>
              <div class="cardContent">
                <h2 class="cardTitle"><%= card.name %></h2>
                <div class="cardMeta">
                  <p class="type"><%= card.types %></p>
                  <p class="mana"><%= card.manaValue %></p>
                </div>
                <p class="rarity <%= card.rarity.toLowerCase() %>"><%= card.rarity %></p>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </main>

    <footer>
      <div class="bottomcardCon">
        <p><%= foundSet.releaseYear %></p>
        <div class="setinfoCon">
          <p><%= foundSet.code %></p>
        </div>
      </div>
    </footer>
  </body>
</html>
